{
  "name": "mitumori",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:client dev:server",
    "dev:client": "npm --workspace client run dev",
    "dev:server": "npm --workspace server run dev",
    "build": "npm-run-all build:client build:server",
    "build:client": "npm --workspace client run build",
    "build:server": "npm --workspace server run build",
    "test": "npm-run-all test:client test:server",
    "test:client": "npm --workspace client test",
    "test:server": "npm --workspace server test",
    "lint": "npm-run-all lint:client lint:server",
    "lint:client": "npm --workspace client run lint",
    "lint:server": "npm --workspace server run lint"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
